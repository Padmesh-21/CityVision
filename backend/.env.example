# Copy this file to .env and fill in real values. Never commit .env.

# --- Django ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
# Comma-separated. Add your machine's LAN IP here once camera nodes on
# other laptops need to reach this server, e.g. 192.168.1.100
ALLOWED_HOSTS=127.0.0.1,localhost

# --- MySQL ---
DB_NAME=anpr_platform
DB_USER=anpr_user
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=3306

# --- CORS (React dev server, Step 6) ---
# Vite's default dev port is 5173; 3000 kept for CRA-style setups too.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# --- JWT ---
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7

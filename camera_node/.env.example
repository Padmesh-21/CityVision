# Copy this file to .env and fill in real values. Never commit .env.
# Each laptop running a camera node gets its own .env with a unique
# CAMERA_ID/API_KEY/location -- the code itself is identical on every node.

# The Django backend from Step 1. Use the host machine's LAN IP once this
# node runs on a different laptop, e.g. http://192.168.1.100:8000
SERVER_URL=http://127.0.0.1:8000

# Must match a Camera already created via POST /api/cameras/ on the backend.
CAMERA_ID=CAM001
# The api_key returned in that camera's creation response (or from
# POST /api/cameras/<id>/regenerate_api_key/).
API_KEY=paste-the-camera-api-key-here

# Should match the latitude/longitude/direction of the Camera record above.
LATITUDE=13.085
LONGITUDE=80.210
DIRECTION=NORTH

# Which physical webcam to open (0 = first camera found).
CAMERA_INDEX=0
# Process one frame every N seconds instead of every frame.
FRAME_SAMPLE_INTERVAL_SECONDS=0.5

# Pretrained YOLOv8 vehicle detector (Step 4). Path is relative to
# camera_node/ -- auto-downloaded to models/yolov8n.pt on first run if missing.
VEHICLE_MODEL_PATH=models/yolov8n.pt
VEHICLE_CONFIDENCE_THRESHOLD=0.4
TRACK_MAX_AGE_SECONDS=2.0

# Only used if detector.MotionVehicleDetector (the Step 2 zero-dependency
# fallback) is swapped in instead of YoloVehicleDetector.
MIN_VEHICLE_AREA=6000

# Don't re-send the same plate within this many seconds.
DEDUP_WINDOW_SECONDS=10

SEND_PLATE_IMAGE=True

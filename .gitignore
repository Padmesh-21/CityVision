# backend/, camera_node/ and frontend/ each have their own .gitignore
# for app-specific ignores (venv, __pycache__, .env, node_modules,
# etc.) -- this file only covers things that don't belong to one app.

# Top-level models/ (shared/reference weights, not camera_node's own
# models/, which has its own .gitignore)
models/*.onnx
models/*.pth

# In case evaluate.py is ever run from the repo root instead of
# camera_node/ -- camera_node/.gitignore only catches it in there.
evaluation_report.json

# Generic safety net for anywhere not already covered by a nested
# .gitignore (e.g. pytest run from the repo root).
*.pyc
.pytest_cache/

# OS / editor
.DS_Store
*.log
.vscode/
.idea/

debug_view.py
